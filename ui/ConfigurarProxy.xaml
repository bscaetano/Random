<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Proxy"
        Height="380"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cadastro -->
        <GroupBox Header="Cadastrar Proxy" Grid.Row="0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Nome label -->
            <RowDefinition Height="Auto"/> <!-- Nome textbox -->
            <RowDefinition Height="Auto"/> <!-- Proxy label -->
            <RowDefinition Height="Auto"/> <!-- Proxy textbox -->
            <RowDefinition Height="Auto"/> <!-- Porta label -->
            <RowDefinition Height="Auto"/> <!-- Porta textbox -->
        </Grid.RowDefinitions>

        <TextBlock Text="Nome do Proxy" Grid.Row="0"/>
        <TextBox Name="txtNome" Grid.Row="1" Margin="0,2,0,8"/>

        <TextBlock Text="Endereço do Proxy" Grid.Row="2"/>
        <TextBox Name="txtProxy" Grid.Row="3" Margin="0,2,0,8"/>

        <TextBlock Text="Porta" Grid.Row="4"/>
        <TextBox Name="txtPort" Grid.Row="5"/>
    </Grid>
</GroupBox>


        <Button Name="btnSalvar"
                Grid.Row="1"
                Content="Cadastrar Proxy"
                Height="30"
                Margin="0,10,0,0"/>

        <!-- Aplicar / Excluir -->
        <GroupBox Header="Proxies Cadastrados" Grid.Row="2" Margin="0,10,0,0">
            <StackPanel Margin="10">
                <ComboBox Name="cmbProxy" Height="25"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Name="btnAplicar" Content="Aplicar" Width="100"/>
                    <Button Name="btnExcluir" Content="Excluir" Width="100" Margin="10,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

    </Grid>
</Window>
