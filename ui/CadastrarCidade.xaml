<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastrar Cidade"
        Height="450"
        Width="380"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Cidade"/>
                <TextBox x:Name="txtCidade"/>

                <TextBlock Text="IP Inicial"/>
                <TextBox x:Name="txtInicio"/>

                <TextBlock Text="IP Final"/>
                <TextBox x:Name="txtFim"/>

                <TextBlock Text="IP Fixo"/>
                <TextBox x:Name="txtIPFixo"/>

                <TextBlock Text="Sub-rede"/>
                <TextBox x:Name="txtSubnet"/>

                <TextBlock Text="Gateway"/>
                <TextBox x:Name="txtGateway"/>

                <TextBlock Text="DNS 1"/>
                <TextBox x:Name="txtDNS1"/>

                <TextBlock Text="DNS 2"/>
                <TextBox x:Name="txtDNS2"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="btnSalvar"
                    Content="Salvar"
                    Width="90"
                    Margin="5"/>
            <Button x:Name="btnCancelar"
                    Content="Cancelar"
                    Width="90"
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Window>